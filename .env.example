# Copy to .env and fill in. docker compose AND the Python app (src/data_pipelines/config.py)
# read this file. Secrets only — non-secret config lives in the committed config.toml.
POSTGRES_USER=kol_torah
POSTGRES_PASSWORD=
POSTGRES_DB=kol_torah
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost  # only needed if connecting from somewhere other than the host

# Host path for the Postgres data directory (bind-mounted, see design.md G7).
POSTGRES_DATA_DIR=./data/postgres

# IAM user credentials for the audio bucket (design.md G9). Bucket name, region, and
# the IAM user name itself are non-secret — see config.toml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# YouTube Data API key, used to resolve channel/playlist ids for the YouTube adapters
# (documents/plans/adapters-plan.md §1.1) — not used by yt-dlp itself, which needs no key.
YOUTUBE_API_KEY=
